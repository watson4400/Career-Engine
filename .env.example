# Jev / TypeSafe — get key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# Or hosted gateway key (jv_live_...)
JEV_API_KEY=
JEV_MODEL=jev-latest

# Coinbase Advanced Trade (CDP API keys)
# https://docs.cdp.coinbase.com/get-started/authentication/jwt-authentication
COINBASE_API_KEY_ID=
COINBASE_API_KEY_SECRET=
COINBASE_PRODUCT_ID=BTC-USD
# true = read book/balances, simulate orders (SAFE DEFAULT)
COINBASE_DRY_RUN=true

# Trading
LIVE_TRADING=false
ALLOW_PAPER_ORDERS=true
KILL_SWITCH_PATH=data/sessions/kill-switch.json

# Live loop knobs
LIVE_CANDLES=5
LIVE_INTERVAL_MS=15000
